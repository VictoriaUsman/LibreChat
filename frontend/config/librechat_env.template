# =============================================================================
# LibreChat Environment Template  –  PBI 9561
# =============================================================================
# Copy this file to scripts/.env and fill in every value.
# scripts/.env is gitignored — never commit it.
#
# Generate secrets on Windows PowerShell:
#   -join ((1..32) | ForEach-Object { '{0:x2}' -f (Get-Random -Max 256) })
#
# Or with openssl (Git Bash / WSL):
#   openssl rand -hex 32   → 64-char hex  (JWT_SECRET, JWT_REFRESH_SECRET, CREDS_KEY)
#   openssl rand -hex 16   → 32-char hex  (CREDS_IV)
# =============================================================================

# ── MongoDB ──────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/LibreChat

# ── Security secrets  (MUST be unique — never use placeholder or default) ───
# Each must be a freshly generated random value, not copied from documentation.
JWT_SECRET=<generate: openssl rand -hex 32>
JWT_REFRESH_SECRET=<generate: openssl rand -hex 32>
CREDS_KEY=<generate: openssl rand -hex 32>
CREDS_IV=<generate: openssl rand -hex 16>

# ── Registration / auth ───────────────────────────────────────────────────────
ALLOW_REGISTRATION=false
ALLOW_SOCIAL_LOGIN=true

# ── Model endpoint visibility ─────────────────────────────────────────────────
# "custom" means only the endpoints defined in librechat.yaml are shown.
# This ensures users see only ROMTech AI Standard and ROMTech AI Fast.
ENDPOINTS=custom

# ── LiteLLM gateway ───────────────────────────────────────────────────────────
# Obtain from Dev 1 (PBI-01-BE handoff) before filling in these values.
LITELLM_BASE_URL=<LITELLM_ACA_URL>
LITELLM_VIRTUAL_KEY=<LITELLM_VIRTUAL_KEY>

# ── LibreChat config file location ───────────────────────────────────────────
# Absolute path to frontend\config\librechat.yaml in this repo.
# LibreChat is cloned at frontend\LibreChat — this config file is one level up.
# Example (adjust to your actual path):
#   CONFIG_PATH=C:\Users\you\Documents\Romtech\ChatGptForEmployees\frontend\config\librechat.yaml
CONFIG_PATH=<absolute-path-to-this-repo>\frontend\config\librechat.yaml

# ── Local LibreChat URL (used by validation scripts) ─────────────────────────
LIBRECHAT_URL=http://localhost:3080

# ── Test user (used by validate_librechat_litellm.py and _persistence.py) ────
# Create this user once after starting LibreChat:
#   cd LibreChat
#   npm run create-user
# Then fill in the credentials you chose below.
LIBRECHAT_TEST_USER_EMAIL=<test-user@example.com>
LIBRECHAT_TEST_USER_PASSWORD=<test-user-password>

# ── Node environment ─────────────────────────────────────────────────────────
NODE_ENV=development
HOST=localhost
PORT=3080
