# LiteLLM — Model Routing Configuration
# -----------------------------------------------------------------------
# This file defines which models LiteLLM exposes and how it routes requests
# to Azure OpenAI. It is mounted into the container at runtime via an
# Azure Files share (see litellm_containerapp.yaml for mount configuration).
#
# Replace every <PLACEHOLDER> with real values before deploying.
# Do NOT commit a filled-in copy of this file to source control.
#
# ALLOWLIST ENFORCEMENT — IMPORTANT:
#   The model_list below IS the allowlist. Requests to any model_name not
#   listed here return a 4xx error.
#   However, LiteLLM will bypass this allowlist if Azure credentials are set
#   as top-level container environment variables (AZURE_API_KEY, AZURE_API_BASE).
#   Callers could then send e.g. "model": "azure/gpt-4o" and reach Azure directly.
#   To prevent this:
#     - Do NOT set AZURE_API_KEY or AZURE_API_BASE as container env vars.
#     - Keep all credentials inside litellm_params entries below.
#     - Validate with scripts/validate_litellm_allowlist.py.
#
# NOTE — API keys in this file:
#   For Phase 0 non-prod, the Azure OpenAI API key is referenced here directly.
#   For Phase 1 production, replace with Key Vault references and use
#   managed identity auth between LiteLLM and Azure OpenAI.
#
# NOTE — Default model:
#   LiteLLM does not enforce a default model — the caller chooses.
#   The recommended default for LibreChat to present to users is:
#   "ROMTech AI Standard". Configure this in LibreChat (PBI-08-FE / PBI-09-FE).
# -----------------------------------------------------------------------

model_list:

  # --- Model 1: ROMTech AI Standard (GPT-4-class, general use, recommended default) ---
  - model_name: "ROMTech AI Standard"
    litellm_params:
      model: azure/<AZURE_OPENAI_DEPLOYMENT_FLAGSHIP>
      api_base: <AZURE_OPENAI_ENDPOINT>
      api_key: <AZURE_OPENAI_API_KEY>
      api_version: "2024-02-01"
    model_info:
      # COST REGISTRATION — REQUIRED, do not leave unfilled.
      # LiteLLM prices a request by looking up litellm_params.model in its
      # built-in cost table, keyed by CANONICAL names (azure/gpt-4.1, azure/gpt-5,
      # ...). Our custom azure/<deployment> names are NOT in that table, so
      # without explicit per-token cost every request prices $0 and the whole
      # department-spend report silently sums to zero. Fill both values from the
      # DEPLOYED model's row in ChatGptForEmployees.docs/Azure_Pricing.md
      # (per-token = per-1M ÷ 1,000,000).
      base_model: azure/<CANONICAL_MODEL>            # e.g. azure/gpt-5 — documents the pricing source; does NOT affect routing
      input_cost_per_token: <INPUT_COST_PER_TOKEN>   # (input $/1M) ÷ 1,000,000
      output_cost_per_token: <OUTPUT_COST_PER_TOKEN> # (output $/1M) ÷ 1,000,000

  # --- Model 2: ROMTech AI Fast (GPT-4o-mini-class, high-volume / low-complexity) ---
  - model_name: "ROMTech AI Fast"
    litellm_params:
      model: azure/<AZURE_OPENAI_DEPLOYMENT_FAST>
      api_base: <AZURE_OPENAI_ENDPOINT>
      api_key: <AZURE_OPENAI_API_KEY>
      api_version: "2024-02-01"
    model_info:
      # COST REGISTRATION — REQUIRED (see the note on ROMTech AI Standard above).
      base_model: azure/<CANONICAL_MODEL_FAST>       # e.g. azure/gpt-5-mini
      input_cost_per_token: <INPUT_COST_PER_TOKEN_FAST>   # (input $/1M) ÷ 1,000,000
      output_cost_per_token: <OUTPUT_COST_PER_TOKEN_FAST> # (output $/1M) ÷ 1,000,000


router_settings:
  num_retries: 2          # Retry transient Azure errors before returning a failure
  timeout: 60             # Seconds before a request is abandoned
  retry_after: 5          # Seconds to wait between retries


litellm_settings:
  drop_params: true       # Silently ignore parameters Azure OpenAI doesn't support
                          # rather than returning a 400 error to the caller


general_settings:
  master_key: <LITELLM_MASTER_KEY>    # Must match the value in the container environment
  # Per-user spend attribution: the department rollup joins on
  # LiteLLM_SpendLogs.end_user, which LiteLLM populates from the OpenAI-compatible
  # `user` field LibreChat sends (the Mongo _id). LiteLLM records end_user by
  # DEFAULT; this explicit opt-in is set for parity with the filled dev config.
  # Confirm its exact effect against the pinned LiteLLM image — it may be a no-op,
  # in which case end_user attribution still works without it.
  allow_user_requests: true
