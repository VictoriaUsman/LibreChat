# LibreChat RAG API -- Environment Configuration Template
# -----------------------------------------------------------------------
# Copy this file to the root of the rag_api clone directory as .env
# Fill in values using credentials from PBI-18-BE (Azure OpenAI embeddings)
# and the RAG_DB_PASSWORD you set in scripts/.env.
#
# This file stays inside the rag_api directory and is NOT committed to the
# ChatGptForEmployees repo. Confirm .env is in rag_api/.gitignore.
#
# rag_api repo: https://github.com/danny-avila/rag_api
# Clone into a sibling directory, e.g.:
#   C:\Users\THISPC\Documents\ROMTech\LibreChat\rag_api\
# -----------------------------------------------------------------------

# =============================================================================
# Embeddings -- Azure OpenAI (from PBI-18-BE)
# =============================================================================

EMBEDDINGS_PROVIDER=azure

# API key for the Azure OpenAI resource hosting the embedding deployment
RAG_AZURE_OPENAI_API_KEY=

# Full endpoint URL from Azure Portal > Azure AI Foundry > Keys and Endpoint
# Format: https://<resource-name>.openai.azure.com/
RAG_AZURE_OPENAI_ENDPOINT=

# Deployment name of the embedding model in Azure AI Foundry
# e.g. text-embedding-ada-002 or text-embedding-3-small
RAG_AZURE_OPENAI_EMBEDDINGS_DEPLOYMENT=

# API version -- 2024-02-01 is confirmed stable for embedding deployments
RAG_AZURE_OPENAI_API_VERSION=2024-02-01

# =============================================================================
# Database -- pgvector (created by setup_pgvector.py)
# -----------------------------------------------------------------------------
# IMPORTANT: the rag_api code (app/config.py) builds its DB connection from
# POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB (plus DB_HOST / DB_PORT).
# It does NOT read DB_USER / DB_PASS / DB_NAME. Use the POSTGRES_* names below.
# =============================================================================

DB_HOST=localhost
DB_PORT=5432
POSTGRES_DB=librechat_rag
POSTGRES_USER=librechat_rag

# Use the same password set as RAG_DB_PASSWORD in scripts/.env (and passed to setup_pgvector.py)
POSTGRES_PASSWORD=

# =============================================================================
# RAG pipeline settings
# =============================================================================

# Collection name stored in langchain_pg_collection
COLLECTION_NAME=librechat

# Document chunking -- adjust if retrieval quality is poor
CHUNK_SIZE=1500
CHUNK_OVERLAP=100

# JWT secret for request auth between LibreChat and the RAG API
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
RAG_API_JWT_SECRET=

# =============================================================================
# Server
# =============================================================================

HOST=0.0.0.0
PORT=8000

# Set to DEBUG for initial troubleshooting, then INFO for normal use
LOG_LEVEL=INFO
