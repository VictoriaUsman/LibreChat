# Azure AI Foundry / Azure OpenAI — Phase 0 Test Endpoint Configuration
# -----------------------------------------------------------------------
# Copy this file to scripts/.env and fill in all values.
# Do NOT commit the .env file to source control.
# Share filled-in values with the team through a secrets manager or secure
# channel (e.g. Azure Key Vault reference, 1Password, encrypted Teams message).
#
# NOTE — Phase 0 vs Production auth:
#   Phase 0 uses API keys for simplicity.
#   Production will use managed identities (no keys stored anywhere).
#   Do not design Phase 1 infrastructure around these keys.
#
# NOTE — BAA coverage:
#   Per Erik's architecture recommendation, every enabled model deployment
#   must be verified BAA-eligible before use. Confirm with the Azure team
#   before enabling any deployment here.


# -----------------------------------------------------------------------
# Shared endpoint — both deployments live under the same Azure AI Foundry
# resource unless the team provisions separate resources.
#
# Location: Azure Portal > Azure OpenAI resource > Keys and Endpoint
#           OR Azure AI Foundry portal > your project > endpoint
# Format:   https://<resource-name>.openai.azure.com/
# -----------------------------------------------------------------------
AZURE_OPENAI_ENDPOINT=

# API key for the Azure OpenAI / Foundry resource.
# Location: Azure Portal > Azure OpenAI resource > Keys and Endpoint
# Key 1 or Key 2 both work. Rotate after Phase 0 is complete.
AZURE_OPENAI_API_KEY=

# Azure OpenAI REST API version.
# Recommendation: keep at 2024-02-01 unless a newer stable version is required.
# Reference: https://learn.microsoft.com/en-us/azure/ai-services/openai/reference
AZURE_OPENAI_API_VERSION=2024-02-01


# -----------------------------------------------------------------------
# Deployment 1 — Flagship model (GPT-4-class, general use)
# This is the default model for most employee interactions.
# In v1 this will be surfaced to users as "ROMTech AI Standard" or similar.
#
# Location: Azure OpenAI Studio > Deployments > your GPT-4-class deployment
# IMPORTANT: This is the deployment NAME you chose, not the base model name.
# Example deployment names: gpt-4o, gpt4o-prod, romtech-standard
# -----------------------------------------------------------------------
AZURE_OPENAI_DEPLOYMENT_FLAGSHIP=

# BAA verification — set to "yes" once confirmed with the Azure team.
AZURE_OPENAI_DEPLOYMENT_FLAGSHIP_BAA_VERIFIED=no


# -----------------------------------------------------------------------
# Deployment 2 — Fast/cheap model (GPT-4o-mini-class, high-volume tasks)
# Used for lower-complexity, high-volume interactions.
# In v1 this will be surfaced to users as "ROMTech AI Fast" or similar.
#
# Location: Azure OpenAI Studio > Deployments > your mini-class deployment
# Example deployment names: gpt-4o-mini, gpt4omini-prod, romtech-fast
# -----------------------------------------------------------------------
AZURE_OPENAI_DEPLOYMENT_FAST=

# BAA verification — set to "yes" once confirmed with the Azure team.
AZURE_OPENAI_DEPLOYMENT_FAST_BAA_VERIFIED=no
