# LibreChat — Azure Container Apps Deployment Configuration
# -----------------------------------------------------------------------
# This file has two sections:
#   1. Container environment variables — go into the Azure Container App
#   2. Validation variables — used by scripts/validate_librechat.py only
#
# Copy this file to scripts/.env and fill in all values.
# Do NOT commit a filled-in copy of this file to source control.
# Store secrets in Azure Key Vault; reference them from the Container App.
#
# NOTE — Phase 0 vs Production auth:
#   Phase 0 uses API keys and secrets set directly in the Container App.
#   Production will use managed identities and Key Vault references.
#
# NOTE — Storage dependency:
#   The Azure File Share mount (PBI 9125) must be configured in the Container
#   Apps environment BEFORE deploying this container. Without it, LibreChat
#   will start but no conversations or config files will persist across restarts.


# -----------------------------------------------------------------------
# SECTION 1 — Container Environment Variables
# Set these in the Azure Container App (or as Key Vault references).
# -----------------------------------------------------------------------

# Network binding — must match ACA ingress targetPort
HOST=0.0.0.0
PORT=3080

# Session security — generate strong random values for each deployment
# Generate with: openssl rand -hex 32
JWT_SECRET=
# Generate with: openssl rand -hex 32
JWT_REFRESH_SECRET=

# Credential encryption — used to encrypt stored API keys in the SQLite DB
# CREDS_KEY must be exactly 32 bytes of hex (64 hex chars)
# CREDS_IV must be exactly 16 bytes of hex (32 hex chars)
# Generate with: openssl rand -hex 32  (for CREDS_KEY)
# Generate with: openssl rand -hex 16  (for CREDS_IV)
CREDS_KEY=
CREDS_IV=

# LiteLLM virtual key issued by Dev 1 (PBI-03-BE / PBI-04-BE handoff)
# Do NOT use the LiteLLM master key here — use a scoped virtual key.
# Leave blank until PBI 9126 — this is only needed after the LiteLLM switch.
LITELLM_VIRTUAL_KEY=

# LiteLLM gateway base URL (from Dev 1 handoff)
# Format: https://<litellm-app-name>.<id>.<region>.azurecontainerapps.io
# Leave blank until PBI 9126.
LITELLM_URL=

# TEMPORARY — Phase 0 only, direct Azure OpenAI connection
# These are used during PBI 9125 validation only.
# REMOVE BOTH once librechat.yaml is deployed for PBI 9126.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=

# Okta OIDC — required for PBI 9129
# Provided by the Okta admin when they register the LibreChat application.
# Leave blank until PBI 9129.
OPENID_CLIENT_ID=
OPENID_CLIENT_SECRET=
OPENID_ISSUER=https://romtech.okta.com/oauth2/default
OPENID_CALLBACK_URL=https://<librechat-aca-url>/api/auth/openid/callback
OPENID_SESSION_SECRET=
OPENID_BUTTON_TEXT=Login with ROMTech Okta


# -----------------------------------------------------------------------
# SECTION 2 — Validation Script Variables (scripts/validate_librechat.py)
# Fill these in after the container app is deployed.
# -----------------------------------------------------------------------

# Full HTTPS URL of the deployed LibreChat Container App.
# Location: Azure Portal > Container Apps > your app > Application URL
# Format:   https://<app-name>.<unique-id>.<region>.azurecontainerapps.io
LIBRECHAT_URL=
