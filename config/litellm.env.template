# LiteLLM — Phase 0 Deployment Configuration
# -----------------------------------------------------------------------
# This file has two sections:
#   1. Container environment variables — go into the Azure Container App
#   2. Validation variables — used by scripts/validate_litellm.py only
#
# For the full container spec, see config/litellm_containerapp.yaml.
# Do NOT commit a filled-in copy of this file to source control.
# Store secrets in Azure Key Vault; reference them from the Container App.


# -----------------------------------------------------------------------
# SECTION 1 — Container Environment Variables
# Set these in the Azure Container App (or as Key Vault references).
# -----------------------------------------------------------------------

# Master API key for the LiteLLM proxy.
# All clients (including LibreChat) must send this as a Bearer token.
# Generate a strong random value — treat it as a secret.
# In prod this will be issued as a Key Vault secret referenced by the container.
LITELLM_MASTER_KEY=

# Port LiteLLM listens on inside the container.
# Must match targetPort in litellm_containerapp.yaml. Do not change unless necessary.
PORT=4000

# Optional: LiteLLM environment label — helpful for distinguishing logs.
LITELLM_ENV=nonprod


# -----------------------------------------------------------------------
# SECTION 2 — Validation Script Variables (scripts/validate_litellm.py)
# Fill these in after the container app is deployed.
# -----------------------------------------------------------------------

# Full HTTPS URL of the deployed Container App.
# Location: Azure Portal > Container Apps > your app > Application URL
# Format:   https://<app-name>.<unique-id>.<region>.azurecontainerapps.io
LITELLM_URL=
